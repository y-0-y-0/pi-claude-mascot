{
  "name": "pi-claude-mascot",
  "version": "1.11.0",
  "description": "Theme-aware pixel-art mascot widget for Pi, rendered above the editor.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "mascot",
    "pixel-art",
    "terminal"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "extensions",
    "test",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-APACHE-2.0.txt",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test --experimental-strip-types test/mascot-widget.test.ts",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "release:verify": "node scripts/verify-published.mjs",
    "prepublishOnly": "npm test && npm run typecheck && npm run pack:check && npm run pack:smoke"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y-0-y-0/pi-claude-mascot.git"
  },
  "bugs": {
    "url": "https://github.com/y-0-y-0/pi-claude-mascot/issues"
  },
  "homepage": "https://github.com/y-0-y-0/pi-claude-mascot#readme",
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
